# Tên miền website của bạn
# Khi bạn mua tên miền thật, chỉ cần điền vào đây (ví dụ: https://tracuuthue.vn)
# Nếu chưa có tên miền, mặc định hệ thống sẽ dùng http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API: tạo key miễn phí tại https://aistudio.google.com/app/apikey
# Dùng để tìm kiếm website, email, hotline doanh nghiệp qua Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Database URI (Lưu trữ tin nhắn liên hệ, yêu cầu ẩn SĐT, lịch sử tra cứu)
# Ví dụ: mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=timkiemcongty

# ScraperAPI: dùng để đi vòng qua lớp chặn bot của trang nguồn khi tra cứu
# Endpoint tìm kiếm của masothue trả về 403 nếu gọi thẳng, nên cần key này thì
# ô tìm kiếm mới lấy được đầy đủ kết quả. Đăng ký tại https://www.scraperapi.com
# Hết credit tháng thì tìm kiếm chỉ còn kết quả trong kho MongoDB của mình.
SCRAPER_API_KEY=

# Key du phong: khi key tren het credit, he thong tu chuyen sang key nay.
# Co the khai bao them SCRAPER_API_KEY_3, hoac ghi nhieu key cach nhau dau phay
# ngay trong mot bien.
SCRAPER_API_KEY_2=

# Tai khoan quan tri. De trong se dung mac dinh admin / admin123.
# Nen doi mat khau truoc khi dua len mang.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Chuoi bi mat dung ky cookie phien dang nhap quan tri
ADMIN_SESSION_SECRET=
