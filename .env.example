# Tên miền website của bạn
# Khi bạn mua tên miền thật, chỉ cần điền vào đây (ví dụ: https://tracuuthue.vn)
# Nếu chưa có tên miền, mặc định hệ thống sẽ dùng http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API: tạo key miễn phí tại https://aistudio.google.com/app/apikey
# Dùng để tìm kiếm website, email, hotline doanh nghiệp qua Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Database URI (Lưu trữ tin nhắn liên hệ, yêu cầu ẩn SĐT, lịch sử tra cứu)
# Ví dụ: mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=timkiemcongty
